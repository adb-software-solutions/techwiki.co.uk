# Stage 1: Build the Vite frontend using pnpm
FROM node:22-alpine AS build

RUN corepack enable && corepack prepare pnpm@10.15.0 --activate

WORKDIR /app

# One pnpm workspace for the repository: install the auth frontend's packages only.
COPY ./package.json ./pnpm-lock.yaml ./pnpm-workspace.yaml ./
COPY ./auth-frontend/package.json ./auth-frontend/
RUN pnpm install --frozen-lockfile --filter "techwiki-auth..."

COPY ./auth-frontend ./auth-frontend
# Copy env file ONLY for build (and remove it afterward just in case)
COPY ./auth-frontend/.ci.env ./auth-frontend/.env.production

RUN pnpm --dir auth-frontend run build && rm -f auth-frontend/.env

# Stage 2: Serve the built app via NGINX
FROM nginx:1.28-alpine-slim

ENV NODE_ENV=production

RUN rm /etc/nginx/conf.d/default.conf
COPY ./auth-frontend/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/auth-frontend/dist /usr/share/nginx/html

EXPOSE 80

# GET /healthz is answered by nginx itself (nginx.conf); nginx on the host
# keeps it off the public site. busybox wget is in the Alpine image.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1/healthz"]

CMD ["nginx", "-g", "daemon off;"]