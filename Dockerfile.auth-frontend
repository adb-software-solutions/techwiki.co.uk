# Stage 1: Build the Vite frontend using pnpm
FROM node:22-alpine AS build

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY ./auth-frontend/package.json ./auth-frontend/pnpm-lock.yaml ./auth-frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY ./auth-frontend .
# Copy env file ONLY for build (and remove it afterward just in case)
COPY ./auth-frontend/.ci.env .env.production

RUN pnpm run build && rm -f .env

# Stage 2: Serve the built app via NGINX
FROM nginx:1.28-alpine-slim

ENV NODE_ENV=production

RUN rm /etc/nginx/conf.d/default.conf
COPY ./auth-frontend/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

# GET /healthz is answered by nginx itself (nginx.conf); nginx on the host
# keeps it off the public site. busybox wget is in the Alpine image.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1/healthz"]

CMD ["nginx", "-g", "daemon off;"]