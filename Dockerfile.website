# Stage 1: Build the Next.js app
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.15.0 --activate

WORKDIR /app

# One pnpm workspace for the repository: install the website's packages only.
COPY ./package.json ./pnpm-lock.yaml ./pnpm-workspace.yaml ./
COPY ./website/package.json ./website/
RUN pnpm install --frozen-lockfile --filter "techwiki..."

COPY ./website ./website

# Optional: include only if you're using env vars at build time
COPY ./website/.ci.env ./website/.env.production


RUN pnpm --dir website run build && rm -f website/.env

# Stage 2: Serve the Next.js app with Node.js
FROM node:22-alpine AS runner

ENV NODE_ENV=production

# Create a non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

# website/node_modules links into the workspace's /app/node_modules, so both
# keep their places.
WORKDIR /app/website

COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/website/public ./public
COPY --from=builder /app/website/.next ./.next
COPY --from=builder /app/website/package.json ./package.json
COPY --from=builder /app/website/node_modules ./node_modules
COPY --from=builder /app/website/next.config.js ./next.config.js
COPY --from=builder /app/website/src/lib/observability/json-console.mjs ./src/lib/observability/json-console.mjs

# JSON logs on stdout for Loki: every Node.js process preloads
# json-console.mjs, which formats console output when LOG_FORMAT=json.
ENV LOG_FORMAT=json \
    NODE_OPTIONS=--import=/app/website/src/lib/observability/json-console.mjs

USER nextjs

EXPOSE 3000

# GET /healthz on the server itself; /metrics (Prometheus) is beside it.
# nginx keeps both off the public site. The image has no curl, so Node's
# fetch makes the request.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:3000/healthz').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]

CMD ["node_modules/.bin/next", "start"]
