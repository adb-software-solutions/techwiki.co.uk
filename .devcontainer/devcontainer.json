{
    "name": "techwiki.co.uk Dev Container",
    "dockerComposeFile": ["docker-compose.yml"],
    "service": "app",
    "workspaceFolder": "${localWorkspaceFolder}",
    "shutdownAction": "stopCompose",

    // Features to install in the container
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/node:1": {
            "nodeGypDependencies": true,
            "version": "22"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12",
            "installTools": true
        }
    },

    // Configure tool-specific properties
    "customizations": {
        "vscode": {
            "extensions": [
                // Python extensions
                "ms-python.python",
                "ms-python.pylance",
                "ms-python.black-formatter",

                // Django extensions
                "batisteo.vscode-django",

                // JavaScript/TypeScript/Frontend extensions
                "esbenp.prettier-vscode",
                "bradlc.vscode-tailwindcss",
                "ms-vscode.vscode-typescript-next",
                "csstools.postcss",
                "ms-vscode.live-server",

                // GitHub extensions
                "github.copilot",
                "github.copilot-chat",
                "github.vscode-pull-request-github",
                "github.remotehub",

                // Docker extensions
                "ms-azuretools.vscode-docker",

                // Git extensions
                "eamodio.gitlens",
                "codezombiech.gitignore",

                // General development
                "ms-vscode.vscode-json",
                "redhat.vscode-yaml",
                "redhat.vscode-xml",
                "dotjoshjohnson.xml",
                "jock.svg",
                "tomoki1207.pdf",

                // Markdown/Documentation
                "unifiedjs.vscode-mdx",

                // AI Tools
                "anthropic.claude-code",
                "openai.chatgpt"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/venv/bin/python",
                "python.formatting.provider": "black",
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": true,
                "python.linting.flake8Enabled": true,
                "python.linting.mypyEnabled": true,
                "editor.formatOnSave": true,
                "python.terminal.activateEnvironment": true,
                "editor.codeActionsOnSave": {
                    "source.organizeImports": "explicit"
                },
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/*.pyc": true
                }
            }
        }
    },

    // Use 'forwardPorts' to make a list of ports inside the container available locally
    "forwardPorts": [
        8000, // Django backend
        3000, // Website (Next.js)
        5432 // PostgreSQL
    ],

    // Port attributes
    "portsAttributes": {
        "8000": {
            "label": "Django Backend",
            "onAutoForward": "notify"
        },
        "3000": {
            "label": "Website (Next.js)",
            "onAutoForward": "notify"
        },
        "5432": {
            "label": "PostgreSQL",
            "onAutoForward": "silent"
        }
    },

    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "postStartCommand": "bash .devcontainer/scripts/link-host-git-config.sh",

    // Set the user to use inside the container
    "remoteUser": "root",

    // Make /opt/venv the default interpreter for everything VS Code launches
    "remoteEnv": {
        "VIRTUAL_ENV": "/opt/venv",
        "PATH": "/opt/venv/bin:${containerEnv:PATH}"
    },

    // Mounts
    "mounts": [
        "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
        "source=vscode-server-extensions,target=/root/.vscode-server/extensions,type=volume",
        // Persistent Bash history
        // The history file will live at /root/.history/.bash_history
        "source=techwiki-bash-history,target=/root/.history,type=volume",

        // Persistent Codex configuration, authentication and sessions
        "source=${localEnv:HOME}/.codex,target=${localEnv:HOME}/.codex,type=bind,consistency=cached",

        // Persistent Claude Code configuration, authentication and sessions
        "source=${localEnv:HOME}/.claude,target=${localEnv:HOME}/.claude,type=bind,consistency=cached",

        // Workspace
        "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

        // Each developer's HOST $HOME (for reading git config)
        "source=${localEnv:HOME},target=/host-home,type=bind,consistency=cached",

        // Mount the host's SSH directory into root's ~/.ssh inside the container
        // Default to read-only for safety; flip to writable if you want to add new hosts from inside.
        "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,consistency=cached,readonly"
    ],

    "containerEnv": {
        // Keep all Claude Code state inside the persistent .claude volume.
        // This also handles state that would otherwise live in /root/.claude.json.
        "CLAUDE_CONFIG_DIR": "${localEnv:HOME}/.claude",

        // Explicitly tell Codex where its persistent home is.
        "CODEX_HOME": "${localEnv:HOME}/.codex"
    }
}
